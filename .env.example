# Backend Configuration
PORT=4000
NODE_ENV=development

# Platform Database (Our Application DB)
PLATFORM_DB_HOST=platform-db
PLATFORM_DB_PORT=5432
PLATFORM_DB_USER=postgres
PLATFORM_DB_PASSWORD=postgres
PLATFORM_DB_NAME=platform_db

# Production Source Database (Factory Mock DB)
PRODUCTION_DB_HOST=production-db
PRODUCTION_DB_PORT=5432
PRODUCTION_DB_USER=postgres
PRODUCTION_DB_PASSWORD=postgres
PRODUCTION_DB_NAME=production_db

# Encryption Key for Secrets at Rest (32 chars hex / string)
SOURCE_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# MQTT Configuration (Optional)
MQTT_ENABLED=false
MQTT_BROKER_URL=mqtt://mosquitto:1883

# Seed Organization & Actor
DEFAULT_ORGANIZATION_ID=org-celesnity-laundry
DEFAULT_ACTOR_ID=actor-plant-manager
DEFAULT_ACTOR_NAME=Plant Manager

# Frontend Public API URL
NEXT_PUBLIC_API_URL=http://localhost:4000
